<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Title -->
    <TextView
        android:id="@+id/setting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Setting"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_green_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_margin="32dp" />

    <!-- "How to Sell" Section -->
    <TextView
        android:id="@+id/how_to_sell_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HOW TO SELL"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/setting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="40dp"
        app:layout_constraintStart_margin="32dp" />

    <TextView
        android:id="@+id/service_notification"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Service Notification"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/how_to_sell_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/switch_service"
        app:layout_constraintStart_margin="32dp"
        app:layout_constraintEnd_margin="16dp"
        app:layout_constraintTop_margin="24dp" />

    <Switch
        android:id="@+id/switch_service"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        app:layout_constraintTop_toTopOf="@id/service_notification"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_margin="32dp" />

    <TextView
        android:id="@+id/latest_information"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Latest Information"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/service_notification"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/switch_latest"
        app:layout_constraintStart_margin="32dp"
        app:layout_constraintEnd_margin="16dp"
        app:layout_constraintTop_margin="24dp" />

    <Switch
        android:id="@+id/switch_latest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        app:layout_constraintTop_toTopOf="@id/latest_information"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_margin="32dp" />

    <!-- "How to Become a Partner" Section -->
    <TextView
        android:id="@+id/how_to_become_partner_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HOW TO BECOME A PARTNER"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/latest_information"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="40dp"
        app:layout_constraintStart_margin="32dp" />

    <TextView
        android:id="@+id/announcement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Announcement"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/how_to_become_partner_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="24dp"
        app:layout_constraintStart_margin="32dp" />

    <TextView
        android:id="@+id/app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App Version"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/announcement"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="24dp"
        app:layout_constraintStart_margin="32dp" />

    <TextView
        android:id="@+id/terms_of_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Terms of Use"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/app_version"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="24dp"
        app:layout_constraintStart_margin="32dp" />

    <!-- Footer Icon -->
    <ImageView
        android:id="@+id/footer_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/recycle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_margin="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>